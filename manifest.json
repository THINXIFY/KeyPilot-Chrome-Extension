{
  "manifest_version": 3,
  "name": "KeyPilot",
  "short_name": "KeyPilot",
  "version": "1.4.0",
  "description": "Smart Password Generator for Chrome",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["storage"]
}
